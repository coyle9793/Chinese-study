   "grammar": [
    {
     "pattern": "Person + (verb) noun + verb + 得 + adjective",
     "meaning": "Describes how well an action is done.",
     "examples": [
      [
       "你（说）中文说得很好。",
       "You speak Chinese very well."
      ],
      [
       "妈妈饭做得很好吃。",
       "Mum's cooking is delicious."
      ],
      [
       "你说得太快了。",
       "You're speaking too fast."
      ]
     ]
    },
    {
     "pattern": "的 / 地 / 得",
     "meaning": "的 goes before nouns (我妹妹的书). 地 goes before verbs to say how (很慢地走). 得 goes after verbs to say how well (他走得很慢).",
     "examples": [
      [
       "她高兴地说……",
       "She said happily..."
      ],
      [
       "他累得不想吃饭。",
       "He's so tired he doesn't want to eat."
      ]
     ]
    },
    {
     "pattern": "Adjective + 极了",
     "meaning": "Extremely + adjective.",
     "examples": [
      [
       "冷极了！",
       "It's freezing!"
      ]
     ]
    },
    {
     "pattern": "才 vs 就 (only)",
     "meaning": "就 = only this thing. 才 = only this person.",
     "examples": [
